<macros>
    <token name="@TOOL_VERSION@">0.1.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <!-- 25.0: first Galaxy release that ships the "markdown" datatype used for the collections. -->
    <token name="@PROFILE@">25.0</token>
    <token name="@MODEL@">gemini-4-argon</token>
    <token name="@MAX_PAPERS@">25</token>

    <xml name="requirements">
        <requirements>
            <requirement type="package" version="3.12.16">python</requirement>
            <requirement type="package" version="2.34.0">google-genai</requirement>
            <requirement type="package" version="2.0">pymupdf</requirement>
            <requirement type="package" version="6.1.3">lxml</requirement>
            <requirement type="package" version="2.34.2">requests</requirement>
        </requirements>
    </xml>

    <!-- The python package lives next to the wrapper; ship it when the tool directory is not shared (e.g. Pulsar). -->
    <xml name="required_files">
        <required_files>
            <include type="glob" path="bars/*.py"/>
            <include type="literal" path="bars/REVIEW_TEMPLATE.md"/>
        </required_files>
    </xml>

    <!--
    Typed identifiers only ever reach the job through a configfile, never the shell command. The sanitizer still drops
    quotes, backslash, backtick and dollar. (Extra redaction terms are not sanitized: a changed term would silently go
    unredacted.)
    -->
    <xml name="text_sanitizer">
        <sanitizer invalid_char="">
            <valid initial="string.printable">
                <add value="ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿĀāĂăĄąĆćĈĉĊċČčĎďĐđĒēĔĕĖėĘęĚěĜĝĞğĠġĢģĤĥĦħĨĩĪīĬĭĮįİıĲĳĴĵĶķĸĹĺĻļĽľĿŀŁłŃńŅņŇňŉŊŋŌōŎŏŐőŒœŔŕŖŗŘřŚśŜŝŞşŠšŢţŤťŦŧŨũŪūŬŭŮůŰűŲųŴŵŶŷŸŹźŻżŽžſ"/>
                <remove value="&apos;"/>
                <remove value="&quot;"/>
                <remove value="\"/>
                <remove value="`"/>
                <remove value="$"/>
            </valid>
        </sanitizer>
    </xml>

    <xml name="citations">
        <citations>
            <citation type="bibtex">@misc{bars_review,
  author = {Kosakovsky Pond, Sergei L. and Nekrutenko, Anton},
  title = {{BARS}: Blinded {AI} Review System ({gemini-reviews})},
  year = {2026},
  howpublished = {\url{https://github.com/spond/gemini-reviews}},
  note = {GitHub repository}
}</citation>
        </citations>
    </xml>
</macros>
